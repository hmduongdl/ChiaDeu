# PostgreSQL
DATABASE_URL=postgres://cashflow:cashflow@localhost:5432/cashflow?sslmode=disable
POSTGRES_DB=cashflow
POSTGRES_USER=cashflow
POSTGRES_PASSWORD=replace-with-a-local-password

# Go backend
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-independent-random-secret-of-at-least-32-characters

# Cookies are Secure by default. Set false only for local development over plain HTTP.
COOKIE_SECURE=false
# Leave empty for host-only cookies. Set only when intentionally sharing a parent domain.
COOKIE_DOMAIN=

# Rate limiting (requests per minute)
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20

# Next.js server-side proxy target. Browser requests should normally stay same-origin at /api.
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=/api

# Existing integrations
SEPAY_API_URL=https://api.sepay.vn
SEPAY_WEBHOOK_SECRET=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENV=sandbox
