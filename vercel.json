{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/api/**/*.go",
      "use": "@vercel/go"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "backend/api/health/health.go"
    },
    {
      "src": "/api/backend/health",
      "dest": "backend/api/health/health.go"
    },
    {
      "src": "/api/auth/register",
      "dest": "backend/api/auth/register/register.go"
    },
    {
      "src": "/api/auth/login",
      "dest": "backend/api/auth/login/login.go"
    },
    {
      "src": "/api/auth/refresh",
      "dest": "backend/api/auth/refresh/refresh.go"
    },
    {
      "src": "/api/auth/logout",
      "dest": "backend/api/auth/logout/logout.go"
    },
    {
      "src": "/api/auth/me",
      "dest": "backend/api/auth/me/me.go"
    },
    {
      "src": "/api/groups/join/(?<shareCode>[^/]+)",
      "dest": "backend/api/groups/join/join.go?shareCode=$shareCode"
    },
    {
      "src": "/api/groups/(?<groupId>[^/]+)/balances",
      "dest": "backend/api/groups/balances/balances.go?groupId=$groupId"
    },
    {
      "src": "/api/groups/(?<groupId>[^/]+)/expenses/(?<expenseId>[^/]+)",
      "dest": "backend/api/groups/expenses/detail/detail.go?groupId=$groupId&expenseId=$expenseId"
    },
    {
      "src": "/api/groups/(?<groupId>[^/]+)/expenses",
      "dest": "backend/api/groups/expenses/index/index.go?groupId=$groupId"
    },
    {
      "src": "/api/groups/(?<groupId>[^/]+)/settlement-batches/(?<batchId>[^/]+)",
      "dest": "backend/api/groups/batches/detail/detail.go?groupId=$groupId&batchId=$batchId"
    },
    {
      "src": "/api/groups/(?<groupId>[^/]+)/settlement-batches",
      "dest": "backend/api/groups/batches/index/index.go?groupId=$groupId"
    },
    {
      "src": "/api/groups/(?<groupId>[^/]+)",
      "dest": "backend/api/groups/detail/detail.go?groupId=$groupId"
    },
    {
      "src": "/api/groups",
      "dest": "backend/api/groups/index/index.go"
    },
    {
      "src": "/api/settlements/(?<settlementId>[^/]+)/(?<action>mark-sent|confirm|reject)",
      "dest": "backend/api/settlements/action/action.go?settlementId=$settlementId&action=$action"
    },
    {
      "src": "/api/webhooks/(?<provider>sepay|payos|momo)",
      "dest": "backend/api/webhooks/webhooks.go?provider=$provider"
    },
    {
      "src": "/api/backend/groups/join/(?<shareCode>[^/]+)",
      "dest": "backend/api/groups/join/join.go?shareCode=$shareCode"
    },
    {
      "src": "/api/backend/groups/(?<groupId>[^/]+)/balances",
      "dest": "backend/api/groups/balances/balances.go?groupId=$groupId"
    },
    {
      "src": "/api/backend/groups/(?<groupId>[^/]+)/expenses/(?<expenseId>[^/]+)",
      "dest": "backend/api/groups/expenses/detail/detail.go?groupId=$groupId&expenseId=$expenseId"
    },
    {
      "src": "/api/backend/groups/(?<groupId>[^/]+)/expenses",
      "dest": "backend/api/groups/expenses/index/index.go?groupId=$groupId"
    },
    {
      "src": "/api/backend/groups/(?<groupId>[^/]+)/settlement-batches/(?<batchId>[^/]+)",
      "dest": "backend/api/groups/batches/detail/detail.go?groupId=$groupId&batchId=$batchId"
    },
    {
      "src": "/api/backend/groups/(?<groupId>[^/]+)/settlement-batches",
      "dest": "backend/api/groups/batches/index/index.go?groupId=$groupId"
    },
    {
      "src": "/api/backend/groups/(?<groupId>[^/]+)",
      "dest": "backend/api/groups/detail/detail.go?groupId=$groupId"
    },
    {
      "src": "/api/backend/groups",
      "dest": "backend/api/groups/index/index.go"
    },
    {
      "src": "/api/backend/settlements/(?<settlementId>[^/]+)/(?<action>mark-sent|confirm|reject)",
      "dest": "backend/api/settlements/action/action.go?settlementId=$settlementId&action=$action"
    },
    {
      "src": "/api/backend/webhooks/(?<provider>sepay|payos|momo)",
      "dest": "backend/api/webhooks/webhooks.go?provider=$provider"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
